# Copy to .env for local dev. On Vercel, set the same names in
# Project → Settings → Environment Variables.

# --- public (sent to the browser) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
TURNSTILE_SITE_KEY=

# --- server only (never put these in the browser) ---
SUPABASE_SERVICE_ROLE_KEY=
# any long random string; used to hash IPs and delete tokens
HASH_SALT=
TURNSTILE_SECRET=
